# Arogya Mithra Monorepo Environment Configuration Template
PROJECT_NAME=Arogya Mithra
ENVIRONMENT=development
DATABASE_URL=sqlite:///./backend/Arogya.db

# LLM Provider Configuration (defaults to offline deterministic mock)
LLM_PROVIDER=mock
# Set to 'gemini' to enable Harshitha's Gemini API prototype:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=30.0
# LLM_FALLBACK_TO_MOCK=true
